<?php
/**
 * @file
 * Leaflet-based avalanche danger rating map block.
 *
 * Generic replacement for gulmarg_danger_map / argentina_danger_map. Danger
 * scale, colors, labels, travel advice, legend link, and map center/zoom are
 * all config-driven via avalanche_center.settings so a single module serves
 * any center. See AVALANCHE_CENTER_DISTRIBUTION_PLAN.md §6.
 */

/**
 * Implements hook_menu_alter().
 *
 * PHP 8 compatibility fix (carried over from argentina_danger_map — the
 * Gulmarg reference lacked it). Core's node_page_title() type-hints its
 * argument as `Node`, but the menu system translates the `node/%` router
 * item (for the View default local task and the node's contextual links)
 * using the raw nid string from the URL map, not a loaded Node object.
 * Under PHP 8 that raw string trips the strict type hint and throws a
 * TypeError (logged on every observation view/edit). Swap in a tolerant
 * wrapper that loads the node when needed.
 */
function avalanche_danger_map_menu_alter(&$items) {
  // The menu item is keyed by its load wildcard (node/%node) at alter time;
  // the router only normalises it to node/% when it is written to the
  // database.
  if (isset($items['node/%node']['title callback']) && $items['node/%node']['title callback'] === 'node_page_title') {
    $items['node/%node']['title callback'] = 'avalanche_danger_map_node_page_title';
  }
}

/**
 * Title callback: tolerant replacement for node_page_title().
 *
 * Accepts either a loaded Node or a nid (string/int) and returns the title.
 *
 * @param Node|string|int $node
 *   A loaded node, or the node ID as passed by an un-loaded menu map.
 *
 * @return string
 *   The node title, or an empty string if it can't be resolved.
 */
function avalanche_danger_map_node_page_title($node) {
  if (!is_object($node)) {
    $node = node_load((int) $node);
  }
  return (is_object($node) && isset($node->title)) ? $node->title : '';
}

/**
 * Implements hook_leaflet_map_info().
 *
 * Provides a multi-layer topo/satellite map for observations and incidents.
 */
function avalanche_danger_map_leaflet_map_info() {
  $attr_esri = 'Tiles &copy; <a target="attr" href="http://esri.com">Esri</a>';
  $attr_osm  = 'Map data &copy; <a target="attr" href="http://openstreetmap.org/copyright">OpenStreetMap</a> contributors';
  $attr_otm  = 'Map data: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, <a href="https://viewfinderpanoramas.org/">SRTM</a> | Map style: &copy; <a href="https://opentopomap.org">OpenTopoMap</a>';

  return array(
    'avalanche_topo_satellite' => array(
      'label' => 'Avalanche Center Topo + Satellite',
      'description' => 'Multi-layer map with topo and satellite options',
      'settings' => array(
        'attributionControl' => TRUE,
        'closePopupOnClick'  => TRUE,
        'doubleClickZoom'    => TRUE,
        'dragging'           => TRUE,
        'fadeAnimation'      => TRUE,
        'layerControl'       => TRUE,
        'maxZoom'            => 19,
        'minZoom'            => 0,
        'scrollWheelZoom'    => TRUE,
        'touchZoom'          => TRUE,
        'trackResize'        => TRUE,
        'zoomAnimation'      => TRUE,
        'zoomControl'        => TRUE,
      ),
      // Order matters: the first base layer is the default selected layer.
      'layers' => array(
        'Street Map' => array(
          'urlTemplate' => 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
          'options' => array(
            'attribution' => $attr_osm,
            'maxZoom'     => 19,
          ),
          'layer_type' => 'base',
        ),
        'OpenTopoMap' => array(
          'urlTemplate' => 'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
          'options' => array(
            'attribution' => $attr_otm,
            'maxZoom'     => 17,
            'subdomains'  => array('a', 'b', 'c'),
          ),
          'layer_type' => 'base',
        ),
        'Satellite' => array(
          'urlTemplate' => '//services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}.png',
          'options' => array(
            'attribution' => $attr_esri,
            'maxZoom'     => 17,
          ),
          'layer_type' => 'base',
        ),
        'Topo Map' => array(
          'urlTemplate' => '//services.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}.png',
          'options' => array(
            'attribution' => $attr_esri,
            'maxZoom'     => 19,
          ),
          'layer_type' => 'base',
        ),
      ),
      'popupMinWidth' => 50,
    ),
  );
}

