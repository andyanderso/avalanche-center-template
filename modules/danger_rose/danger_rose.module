    ),
  );
}

/**
 * Implements hook_field_widget_form().
 */
function danger_rose_field_widget_form(&$form, &$form_state, $field, $instance, $langcode, $items, $delta, $element) {

  $info = _get_max_columns($instance['widget']['type']);

  $field_name = $instance['field_name'];
  $item =& $items[$delta];

  $element += array('#type' => 'fieldset');

  $target_base = $field_name . '[' . $element['#language'] . '][' . $delta . ']';
  // Walk the array and set the values for all of the rose elements.
  for ($i = 0; $i < $info['column_count']; $i++) {
    $element[$i] = array(
      '#type' => 'hidden',
      '#default_value' => isset($item[$i]) ? $item[$i] : '0',
      '#attributes' => array('name' => $target_base . '[' . $i . ']'),
    );
  }

  $svg_file_path = '/' . backdrop_get_path('module', 'danger_rose') . '/svg/' . $instance['widget']['type'] . '.svg';
  $element['rose'] = array(
    '#markup' => <<<EOT
<object type="image/svg+xml" data="{$svg_file_path}" width="500" height="300">
  <param id="target_base" value="{$target_base}"/>
  <param id="column_count" value="{$info['column_count']}"/>
  <param id="element_count" value="{$info['element_count']}"/>
</object>
EOT
  );

  return $element;
}

/**
 * Implements hook_field_widget_settings_form().
 */
function danger_rose_field_widget_settings_form($field, $instance) {
  $widget = $instance['widget'];
  $settings = $widget['settings'];

  $a = array(
    'lower' => array(
      '#type' => 'textfield',
      '#title' => t('Lower elevation label'),
      '#default_value' => 'Below treeline',
      '#size' => 25,
    ),
    'mid' => array(
      '#type' => 'textfield',
      '#title' => t('Mid elevation label'),
      '#default_value' => 'Near treeline',
      '#size' => 25,
    ),
    'upper' => array(
      '#type' => 'textfield',
      '#title' => t('Upper elevation label'),
      '#default_value' => 'Above treeline',
      '#size' => 25,
    ),
  );

  $form['elfs'] = array(
    '#type' => 'fieldset',
    '#title' => 'Elevation level labels',
    '#description' => 'Labels defined here will be displayed on the <b>Large rose</b> field format.',
  );

  if ($widget['type'] == 'dual_picker_widget') {
    $form['elfs']['lower_elev_label'] = $a['lower'];
    $form['elfs']['upper_elev_label'] = $a['upper'];
  }
  elseif ($widget['type'] == 'loc_dual_picker_widget') {
    $form['elfs']['lower_elev_label'] = $a['lower'];
    $form['elfs']['upper_elev_label'] = $a['upper'];
  }
  else {
    $form['elfs']['lower_elev_label'] = $a['lower'];
    $form['elfs']['mid_elev_label'] = $a['mid'];
    $form['elfs']['upper_elev_label'] = $a['upper'];
  }

  if (array_key_exists('elfs', $settings)) {
    foreach (array('lower_elev_label', 'mid_elev_label', 'upper_elev_label') as $key) {
      if (array_key_exists($key, $settings['elfs'])) {
        $form['elfs'][$key]['#default_value'] = $settings['elfs'][$key];
      }
    }
  }

  $url = isset($_SERVER['HTTP_REFERER']) ? $_SERVER['HTTP_REFERER'] : '';
  $domain = $url ? parse_url($url, PHP_URL_HOST) : '';
  $form['watermark'] = array(
    '#type' => 'textfield',
    '#title' => t('Watermark'),
    '#default_value' => $domain ? "http://$domain" : '',
    '#description' => 'A small watermark can be placed at the bottom of the rose.',
    '#size' => 25,
  );

  return $form;
}

/**
 * Returns column/element counts for a given widget type.
 *
 * We need two pieces of information to pass to SVG:
 * 1. The number of columns, as described in the schema. If a smaller rose is
 *    used, 0's are stored for missing elements.
 * 2. The number of elements in the rose.
 *
 * @see hook_field_schema()
 * @see hook_field_widget_form()
 */
function _get_max_columns($type = 'triple_picker_widget') {
  $a = array('column_count' => 24);
  if ($type == 'dual_picker_widget') { $a['element_count'] = 16; }
  elseif ($type == 'loc_dual_picker_widget') { $a['element_count'] = 16; }
  else { $a['element_count'] = $a['column_count']; }

  return $a;
}
