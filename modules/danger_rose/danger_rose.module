<?php

/**
 * @file
 *
 * The danger_rose module file.
 */

/**
 * Implements hook_config_info().
 */
function danger_rose_config_info() {
  $prefixes['danger_rose.settings'] = array(
    'label' => t('Danger Rose settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_field_info().
 */
function danger_rose_field_info() {
  return array(
    'danger_rose_picker' => array(
      'label' => t('Danger rose'),
      'description' => t('This field stores a danger rose in the database.'),
      'default_widget' => 'triple_picker_widget',
      'default_formatter' => 'danger_rose_large_visual_formatter',
    ),
  );
}

/**
 * Restrict usage to single rose for each instance.
 */
function danger_rose_form_field_ui_field_edit_form_alter(&$form, &$form_state) {
  if ($form['#field']['type'] == 'danger_rose_picker') {
    $form['field']['cardinality']['#default_value'] = 1;
    $form['field']['#access'] = FALSE;
  }
}

/**
 * Implements hook_field_presave().
 */
function danger_rose_field_presave($entity_type, $entity, $field, $instance, $langcode, &$items) {
  require_once(backdrop_get_path('module', 'danger_rose') . '/inc/rose.inc');

  // In Backdrop, the public files path is stored in system.core config.
  $relpath = config_get('system.core', 'file_public_path');
  if (empty($relpath)) {
    $relpath = 'files';
  }

  if ($instance['widget']['type'] == 'dual_picker_widget') { $rose_size = 2; }
  else { $rose_size = 3; }
  $rose = new Rose($rose_size);
  $rose->set_font_path(backdrop_get_path('module', 'danger_rose') . '/inc');
  $path = backdrop_realpath(file_default_scheme() . '://') . '/forecast';
  $rose->set_destination($path);
  $rose->set_values($items[0]);
  $rose->set_labels($instance['widget']['settings']['elfs']);
  $rose->set_watermark($instance['widget']['settings']['watermark']);

  $detailed_rose = $rose->generate();
  $detailed_rose = '/' . $relpath . '/forecast/' . $detailed_rose;

  $rose->set_size_small();
  $simplified_rose = $rose->generate();
  $simplified_rose = '/' . $relpath . '/forecast/' . $simplified_rose;

  $items[0]['img_detailed_rose'] = $detailed_rose;
  $items[0]['img_simplified_rose'] = $simplified_rose;
}

/**
 * Implements hook_field_validate().
 */
function danger_rose_field_validate($entity_type, $entity, $field, $instance, $langcode, $items, &$errors) { }

/**
 * Implements hook_field_is_empty().
 */
function danger_rose_field_is_empty($item, $field) { return FALSE; }

/**
 * Implements hook_field_formatter_info().
 */
function danger_rose_field_formatter_info() {
  return array(
    'danger_rose_large_visual_formatter' => array(
      'label' => t('Large rose'),
      'field types' => array('danger_rose_picker'),
    ),
    'danger_rose_small_visual_formatter' => array(
      'label' => t('Small rose'),
      'field types' => array('danger_rose_picker'),
    ),
  );
}

/**
 * Implements hook_field_formatter_view().
 */
function danger_rose_field_formatter_view($entity_type, $entity, $field, $instance, $langcode, $items, $display) {
  $element = array();
  switch ($display['type']) {
    case 'danger_rose_large_visual_formatter':
      foreach ($items as $delta => $item) {
        $element[$delta] = array(
          '#type' => 'html_tag',
          '#tag' => 'img',
          '#attributes' => array('src' => $item['img_detailed_rose']),
        );
      }
      break;

    case 'danger_rose_small_visual_formatter':
      foreach ($items as $delta => $item) {
        $element[$delta] = array(
          '#type' => 'html_tag',
          '#tag' => 'img',
          '#attributes' => array('src' => $item['img_simplified_rose']),
        );
      }
      break;
  }

  return $element;
}

/**
 * Implements hook_field_widget_info().
 */
function danger_rose_field_widget_info() {
  return array(
    'dual_picker_widget' => array(
      'label' => t('Dual elevation picker - Danger'),
      'field types' => array('danger_rose_picker'),
    ),
    'loc_dual_picker_widget' => array(
      'label' => t('Dual elevation picker - Location'),
      'field types' => array('danger_rose_picker'),
    ),
    'triple_picker_widget' => array(
      'label' => t('Triple elevation picker - Danger'),
      'field types' => array('danger_rose_picker'),
