# --- Danger scale travel advice ---
msgid "<strong>Generally safe avalanche conditions.</strong> Watch for unstable snow on isolated terrain features."
msgstr "<strong>Condiciones de avalancha generalmente seguras.</strong> Preste atención a la nieve inestable en sectores aislados del terreno."

msgid "<strong>Heightened avalanche conditions on specific terrain features.</strong> Evaluate snow and terrain carefully; identify features of concern."
msgstr "<strong>Condiciones de avalancha elevadas en sectores específicos del terreno.</strong> Evalúe la nieve y el terreno cuidadosamente; identifique los sectores de riesgo."

msgid "<strong>Dangerous avalanche conditions.</strong> Careful snowpack evaluation, cautious route-finding, and conservative decision-making essential."
msgstr "<strong>Condiciones de avalancha peligrosas.</strong> Es esencial una evaluación cuidadosa del manto nivoso, una elección de ruta prudente y una toma de decisiones conservadora."

msgid "<strong>Very dangerous avalanche conditions.</strong> Travel in avalanche terrain not recommended."
msgstr "<strong>Condiciones de avalancha muy peligrosas.</strong> No se recomienda transitar por terreno de avalanchas."

msgid "<strong>Extraordinarily dangerous avalanche conditions.</strong> Avoid all avalanche terrain."
msgstr "<strong>Condiciones de avalancha extraordinariamente peligrosas.</strong> Evite todo terreno de avalanchas."

