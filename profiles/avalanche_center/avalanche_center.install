<?php
/**
 * @file
 * Install-time hooks for the Avalanche Center distribution.
 *
 * Structural config (profiles/avalanche_center/config/) auto-imports from
 * this profile's config/ directory via Backdrop's own
 * config_install_default_config() as part of normal profile installation -
 * nothing here needs to trigger that explicitly. Exception:
 * config_install_default_config() only ever *creates* config, never
 * overwrites it - see avalanche_center_install() below.
 */

/**
 * Implements hook_install().
 *
 * Runs during profile installation, before the "Center setup" form
 * (avalanche_center.profile's hook_install_tasks()) is ever shown - so it
 * has no access to center-specific values a user hasn't entered yet. This
 * only seeds sane fallback defaults for avalanche_center.settings, in case
 * the setup form is ever skipped (e.g. an automated/scripted install that
 * bypasses install_state tasks). The setup form's submit handler
 * overwrites these with real values in the normal interactive install
 * path - see avalanche_center.profile.
 */
function avalanche_center_install() {
  $settings = config('avalanche_center.settings');
  if (!$settings->get('danger_scale')) {
    $settings->set('danger_scale', 'NAC');
    $settings->set('map_center_lat', 0);
    $settings->set('map_center_lng', 0);
    $settings->set('map_zoom', 2);
    $settings->save();
  }

  avalanche_center_force_apply_config(array(
    'user.role.anonymous',
    'user.role.authenticated',
    // auto_nodetitle ships its own empty-default auto_nodetitle.settings
    // when the module is enabled, so config_install_default_config() skips
    // ours (which sets ant_advisory/ant_observation = "1", etc.). Without
    // this the advisory/observation forms keep showing an editable title
    // field instead of auto-generating and hiding it. Same overwrite-
    // protection gotcha as the role configs above.
    'auto_nodetitle.settings',
    // Core's layout module ships its own layout.layout.default (the generic
    // moscone_flipped layout) and layout.layout.admin_default, so
    // config_install_default_config() skips ours. The result: only paths
    // matching layout.layout.node (node/%, a name core does NOT ship, so it
    // imports fine) get the responsive_sac theming - every other path
    // (/advisory, /observations, /node/add/*, taxonomy pages, etc.) falls
    // through to core's bare moscone_flipped default with no site header,
    // mega-menu, or sidebars. Force ours into place so the whole site is
    // themed, not just node pages.
    'layout.layout.default',
    'layout.layout.admin_default',
    // metatag ships its own metatag.settings default when enabled, so ours
    // is skipped - and core's default enables only the Open Graph tags, not
    // the twitter:* Twitter Card tags or fb:* tags. avalanche_social_meta
    // feeds twitter:image/og:image, so without ours a shared link gets a
    // Facebook preview card but no Twitter/X card. Ours is a strict superset
    // of core's enabled tag list (adds twitter:* + fb:*), so forcing it only
    // turns more available tags on - found by the config-collision sweep.
    // NOTE: deliberately NOT forcing the metatag.instance.* configs - ours
    // ship disabled=true, but core's active copies are enabled, which is what
    // we want (disabling them would switch metatags off entirely).
    'metatag.settings',
  ));

  // Declaring themes[] in avalanche_center.info only makes them available -
  // Backdrop doesn't enable or default to any of them on its own, and (like
  // roles above) our profile ships no system.core.json to set theme_default
  // via passive config import. Without this, the site is stuck on core's
  // bare "stark" fallback theme, and any layout whose layout_template is
  // "responsive_sac" (layout.layout.node/default.json, matching the Gulmarg
  // baseline) fails outright since that theme was never enabled at all.
  // Canonical baseline (Gulmarg) runs *_modern as the default theme, basis
  // as the admin theme, with responsive_sac enabled (not default) purely to
  // supply that layout template - reproduced here.
  theme_enable(array('avalanche_modern', 'responsive_sac', 'responsive_bartik', 'basis'));
  config_set('system.core', 'theme_default', 'avalanche_modern');
  config_set('system.core', 'admin_theme', 'basis');

  avalanche_center_enable_glossary_filter();
}

/**
 * Turns on the avalanche_glossary "Mark glossary terms" filter for the
 * full_html format.
 *
 * Mirrors the live Gulmarg site, where the Lexicon filter runs on the same
 * full-HTML WYSIWYG profile advisories are authored in - so glossary terms
 * typed into an advisory (or any full_html content) auto-link to their
 * definition. full_html is core-shipped config, so config_install_default_config()
 * skips any version we ship; enable the filter on the active format here.
 */
function avalanche_center_enable_glossary_filter() {
  $config = config('filter.format.full_html');
  if ($config->isNew()) {
    return;
  }
  $filters = $config->get('filters');
  if (!is_array($filters)) {
    $filters = array();
  }
  if (!isset($filters['avalanche_glossary_mark'])) {
    $filters['avalanche_glossary_mark'] = array(
      'module' => 'avalanche_glossary',
      'status' => 1,
      // After the other filters have produced their HTML.
      'weight' => 20,
      'settings' => array(),
    );
    $config->set('filters', $filters);
    $config->save();
  }
}

/**
 * Enables Spanish as the default site language and imports the bundled
 * interface translations.
 *
 * Called from the "Center setup" install task when the operator picks Spanish.
 * The es.po shipped in this profile's translations/ directory was extracted
 * from the reference Spanish-language avalanche center (real, human-verified
 * strings) and is center-agnostic, so it is reusable by any Spanish install
 * (e.g. a future Chilean center). English is left enabled as a secondary
 * language so any untranslated string falls back to it.
 */
function avalanche_center_enable_spanish() {
  // language + locale are profile dependencies, but be defensive if this
  // helper is ever reused outside the standard install.
  $needed = array();
  if (!module_exists('language')) {
    $needed[] = 'language';
  }
  if (!module_exists('locale')) {
    $needed[] = 'locale';
  }
  if ($needed) {
    module_enable($needed);
  }

  // Add Spanish and make it the default language. language_save() fills in the
  // name/native/direction from the standard language list and updates the
  // system.core language_default + language_count config.
  language_save((object) array(
    'langcode' => 'es',
    'default' => TRUE,
  ));

  // Enabling locale turns on locale-url negotiation (path-prefix based), which
  // makes an un-prefixed URL resolve inconsistently between es and en. This
  // is a single-language Spanish site (English is only a string-level
  // fallback, not a switchable second UI), so pin interface negotiation to the
  // default language - es everywhere.
  config_set('language.settings', 'language_negotiation', array(
    'language' => array('language-default'),
  ));

  // Import the bundled translations against the strings registered so far.
  // es.po is the core/contrib UI extract; avalanche_center.es.po carries this
  // profile's own strings (navigation labels, demo content, reference page
  // titles).
  require_once BACKDROP_ROOT . '/core/includes/gettext.inc';
  require_once BACKDROP_ROOT . '/core/includes/locale.inc';
  $base = backdrop_get_path('profile', 'avalanche_center') . '/translations';
  foreach (array('es.po', 'avalanche_center.es.po') as $filename) {
    $path = $base . '/' . $filename;
    if (is_file($path)) {
      $file = (object) array('uri' => $path, 'filename' => $filename);
      _locale_import_po($file, 'es', LOCALE_IMPORT_KEEP);
    }
    else {
      watchdog('avalanche_center', 'Spanish translation file not found at %path.', array('%path' => $path), WATCHDOG_WARNING);
    }
  }

  // Switch the active interface language to Spanish for the rest of the
  // install request, so the t()-wrapped demo content created next comes out in
  // Spanish (wherever a translation exists; untranslated strings fall back to
  // English). Without this, content creation would run in the installer's own
  // language (English).
  $languages = language_list();
  if (isset($languages['es'])) {
    $GLOBALS['language'] = $languages['es'];
    $GLOBALS['language_content'] = $languages['es'];
  }

  // The mega-menu dropdown blocks and sidebar link blocks store their link
  // text as raw HTML in config (block.custom.*), which the block system
  // renders verbatim - it never passes through t(), so the PO import above
  // can't reach it. Rewrite those bodies to the target language here.
  avalanche_center_localize_menu_blocks('es');

  // View display titles, field labels and date-format patterns are stored in
  // the exported views config as literal strings - Views never runs them
  // through t() at render time, so, like the menu blocks, the PO import can't
  // reach them. Rewrite the visitor-facing ones (homepage forecast/archive,
  // announcements, observations, incidents, events, etc.) into the target
  // language here. Also localizes the content-type display label.
  avalanche_center_localize_views('es');

  // The observations/incidents views carry multi-sentence explanatory HTML in
  // their header areas (stored config, not t()) - localize those too.
  avalanche_center_localize_view_headers('es');

  // Menu titles double as the footer menu-block headings (blocks use the menu
  // title when they set no title of their own), so localize the visitor-facing
  // ones too.
  avalanche_center_localize_menus('es');

  // The observation submission form's field labels, help text, option lists
  // and the content-type name are all stored config (not t()), so localize
  // them here as well.
  avalanche_center_localize_observation_form('es');

  // Spanish-speaking avalanche centers (Chile, Argentina, ...) forecast in
  // metric, so default the weather tables to metric units.
  config_set('avalanche_modern.settings', 'weather_units', 'metric');

  // Give the main navigation Spanish public URLs (/pronostico instead of
  // /forecast, /observaciones instead of /observations, ...) via path aliases.
  // The internal router paths stay English/generic, so the module code remains
  // center-agnostic; only the visible URL changes, and only for this language.
  avalanche_center_create_url_aliases('es');
}

/**
 * Internal router path => localized URL-alias map for a language.
 *
 * ASCII aliases only (no accents): browsers percent-encode non-ASCII and
 * Backdrop's own alias handling transliterates them, so an accented alias is
 * fragile. The visible link text keeps its accents ("Pronóstico"); only the
 * URL slug is ASCII ("pronostico"). Returns an empty array for languages with
 * no map, so callers can loop unconditionally.
 *
 * @param string $langcode
 *   Target language.
 *
 * @return array
 *   source (internal path) => alias (URL slug).
 */
function avalanche_center_url_alias_map($langcode) {
  if ($langcode === 'es') {
    return array(
      'forecast' => 'pronostico',
      'archive' => 'archivo',
      'text-advisory' => 'pronostico-texto',
      'observations' => 'observaciones',
      'observations-map' => 'observaciones-mapa',
      'observations-archive' => 'observaciones-archivo',
      'observations-map-archive' => 'observaciones-mapa-archivo',
      'incidents' => 'incidentes',
      'incidents-map' => 'incidentes-mapa',
      'incidents-archive' => 'incidentes-archivo',
      'incidents-map-archive' => 'incidentes-mapa-archivo',
    );
  }
  return array();
}

/**
 * Creates localized URL aliases for the main navigation paths.
 *
 * Aliases a bare router/view path (e.g. the module's "forecast" hook_menu
 * callback, or a view's "observations" page) to a localized slug. Because
 * url() resolves system paths to their alias automatically, every link the
 * code builds with url('forecast') then emits "/pronostico" without any code
 * change. Idempotent: an existing alias for the same source is removed first,
 * so re-running (or a migration) always lands on exactly the mapped slug.
 *
 * @param string $langcode
 *   Target language; a no-op if no alias map is shipped for it.
 */
function avalanche_center_create_url_aliases($langcode) {
  foreach (avalanche_center_url_alias_map($langcode) as $source => $alias) {
    // Clear any prior alias for this source so url() output is deterministic.
    path_delete(array('source' => $source));
    // path_save() takes its argument by reference (it writes back the new pid),
    // so it needs a variable, not an array literal.
    $path = array(
      'source' => $source,
      'alias' => $alias,
      'langcode' => LANGUAGE_NONE,
    );
    path_save($path);
  }
}

/**
 * Rewrites the custom link-block bodies (mega-menu dropdowns + sidebar link
 * lists) into the given language.
 *
 * These blocks (block.custom.2/4/5/6/7/18) hold their link text as stored
 * HTML that the block module outputs as-is, so unlike t()-wrapped strings the
 * interface-translation import never touches them. Their link *targets* (the
 * URL aliases) are language-independent and stay the same; only the visible
 * text changes. Center-agnostic - the link labels are generic - so any
 * same-language install (e.g. a future Chilean center) reuses them.
 *
 * @param string $langcode
 *   Target language. A no-op if no translations are shipped for it.
 */
function avalanche_center_localize_menu_blocks($langcode) {
  $bodies = array();
  if ($langcode === 'es') {
    $bodies = array(
      2 => '<div><a href="/pronostico">Pronóstico de Avalanchas de Hoy</a></div>' . "\n"
        . '<div><a href="/archivo">Archivo de Pronósticos</a></div>' . "\n"
        . '<div><a href="/pronostico-texto">Pronóstico en Texto</a></div>' . "\n",
      4 => '<div><a href="/how-to-read-avalanche-forecast">Cómo Leer el Pronóstico</a></div>' . "\n"
        . '<div><a href="/avalanche-danger-scale">La Escala de Peligro</a></div>' . "\n"
        . '<div><a href="/avalanche-problems">Problemas de Avalancha</a></div>' . "\n",
      5 => '<div><a href="/observaciones">Observaciones - Vista de Lista</a></div>' . "\n"
        . '<div><a href="/observaciones-mapa">Observaciones - Vista de Mapa</a></div>' . "\n"
        . '<div><a href="/observaciones-archivo">Observaciones Archivadas - Vista de Lista</a></div>' . "\n"
        . '<div><a href="/observaciones-mapa-archivo">Observaciones Archivadas - Vista de Mapa</a></div>' . "\n",
      6 => '<div><a href="/incidentes">Incidentes - Vista de Lista</a></div>' . "\n"
        . '<div><a href="/incidentes-mapa">Incidentes - Vista de Mapa</a></div>' . "\n"
        . '<div><a href="/incidentes-archivo">Incidentes Archivados - Vista de Lista</a></div>' . "\n"
        . '<div><a href="/incidentes-mapa-archivo">Incidentes Archivados - Vista de Mapa</a></div>' . "\n",
      7 => '<div class="submit-obs-button" style="text-align:center"><a href="/node/add/observation">Enviar Observaciones</a></div>' . "\n",
      18 => '<div style="text-align:center"><span class="submit-obs-button" style="display:inline-block;height:42px;"><a href="/node/add/observation">Enviar Observaciones</a></span></div>' . "\n",
    );
  }

  foreach ($bodies as $delta => $value) {
    $config = config('block.custom.' . $delta);
    if ($config->isNew()) {
      // Block not present in this install; skip rather than create a stub.
      continue;
    }
    $config->set('body.value', $value);
    $config->save();
  }
}

/**
 * Rewrites Views display titles, field labels and date-format patterns into
 * the given language.
 *
 * Everything a shipped View shows that isn't node content - the display/page
 * title ("Most Current Avalanche Forecast:"), the field labels ("Recent
 * Observations", "Mountain Weather", the weather grid, ...) and the date
 * format patterns - lives as literal strings in the views.view.* config.
 * Views emits them verbatim; they never pass through t(), so the interface-
 * translation (PO) import can't touch them. This walks the relevant view
 * configs and replaces the exact English strings with their target-language
 * equivalents (exact-match only, so machine names and untranslated strings
 * are left untouched). It also localizes the forecast content-type's display
 * label. Center-agnostic: the strings are generic forecast-site vocabulary,
 * so any same-language install reuses them.
 *
 * @param string $langcode
 *   Target language. A no-op if no map is shipped for it.
 */
function avalanche_center_localize_views($langcode) {
  if ($langcode !== 'es') {
    return;
  }

  // Exact English -> Spanish for every visitor-facing view "title" and
  // "label". Applied by exact match only.
  $strings = array(
    // advisory_views: display/page titles.
    'Most Current Avalanche Forecast:' => 'Pronóstico de Avalancha Más Reciente:',
    'Archived Avalanche Forecasts' => 'Pronósticos de Avalancha Archivados',
    'Overall Danger Ratings for the Week' => 'Grados de Peligro Generales de la Semana',
    'The Bottom Line:' => 'Lo Más Importante:',
    'The Bottom Line from the Avalanche Forecast' => 'Lo Más Importante del Pronóstico de Avalancha',
    'Avalanche Forecast' => 'Pronóstico de Avalancha',
    'Avalanche Danger Rating' => 'Grado de Peligro de Avalancha',
    'Avalanche Forecasts and Snow, Weather, and Avalanche Information' => 'Pronósticos de Avalancha e Información de Nieve, Clima y Avalanchas',
    // Pre-rename ("Advisory") equivalents of the titles/labels above, plus the
    // trailing-space variants, so this map localizes both a fresh post-rename
    // install AND an existing site being migrated from before the
    // advisory->forecast rename (its config still carries the old strings).
    'Most Current Avalanche Advisory:' => 'Pronóstico de Avalancha Más Reciente:',
    'Archived Avalanche Advisories' => 'Pronósticos de Avalancha Archivados',
    'The Bottom Line from the Avalanche Advisory' => 'Lo Más Importante del Pronóstico de Avalancha',
    'Avalanche Advisory published on' => 'Pronóstico de Avalancha publicado el',
    'This advisory is valid for' => 'Este pronóstico es válido para',
    'Date the advisory was published:' => 'Fecha de publicación del pronóstico:',
    'Advisory' => 'Pronóstico',
    'Forecast' => 'Pronóstico',
    'Avalanche Advisory ' => 'Pronóstico de Avalancha ',
    'Avalanche Forecast ' => 'Pronóstico de Avalancha ',
    // advisory_views: displayed field labels.
    'Recent Observations' => 'Observaciones Recientes',
    'Bottom Line' => 'Lo Más Importante',
    'Mountain Weather' => 'Clima de Montaña',
    'Overall Danger Rating' => 'Grado de Peligro General',
    'Avalanche Forecast published on' => 'Pronóstico de Avalancha publicado el',
    'This forecast is valid for' => 'Este pronóstico es válido para',
    'Date the forecast was published:' => 'Fecha de publicación del pronóstico:',
    'Today the avalanche danger is' => 'Hoy el peligro de avalancha es',
    'Total Snow Depth' => 'Profundidad Total de Nieve',
    'Region' => 'Región',
    'Avalanche Problem #1' => 'Problema de Avalancha #1',
    'Avalanche Problem #2' => 'Problema de Avalancha #2',
    'Avalanche Problem #3' => 'Problema de Avalancha #3',
    // Weather grid (Today / Tonight / Tomorrow x 7-8 / 8-9 x metric).
    'Today 7-8 Snow' => 'Hoy 7-8 Nieve',
    'Today 7-8 Temp' => 'Hoy 7-8 Temp.',
    'Today 7-8 Weather ' => 'Hoy 7-8 Clima ',
    'Today 7-8 Wind Direction' => 'Hoy 7-8 Dirección del Viento',
    'Today 7-8 Wind Speed' => 'Hoy 7-8 Velocidad del Viento',
    'Today 8-9 Snow' => 'Hoy 8-9 Nieve',
    'Today 8-9 Temp' => 'Hoy 8-9 Temp.',
    'Today 8-9 Weather' => 'Hoy 8-9 Clima',
    'Today 8-9 Wind Direction' => 'Hoy 8-9 Dirección del Viento',
    'Today 8-9 Wind Speed' => 'Hoy 8-9 Velocidad del Viento',
    'Tonight 7-8 Snow' => 'Esta Noche 7-8 Nieve',
    'Tonight 7-8 Temp' => 'Esta Noche 7-8 Temp.',
    'Tonight 7-8 Weather' => 'Esta Noche 7-8 Clima',
    'Tonight 7-8 Wind Direction' => 'Esta Noche 7-8 Dirección del Viento',
    'Tonight 7-8 Wind Speed' => 'Esta Noche 7-8 Velocidad del Viento',
    'Tonight 8-9 Snow' => 'Esta Noche 8-9 Nieve',
    'Tonight 8-9 Temp' => 'Esta Noche 8-9 Temp.',
    'Tonight 8-9 Weather' => 'Esta Noche 8-9 Clima',
    'Tonight 8-9 Wind Direction' => 'Esta Noche 8-9 Dirección del Viento',
    'Tonight 8-9 Wind Speed' => 'Esta Noche 8-9 Velocidad del Viento',
    'Tomorrow 7-8 Snow' => 'Mañana 7-8 Nieve',
    'Tomorrow 7-8 Temp' => 'Mañana 7-8 Temp.',
    'Tomorrow 7-8 Weather' => 'Mañana 7-8 Clima',
    'Tomorrow 7-8 Wind Direction' => 'Mañana 7-8 Dirección del Viento',
    'Tomorrow 7-8 Wind Speed' => 'Mañana 7-8 Velocidad del Viento',
    'Tomorrow 8-9 Snow' => 'Mañana 8-9 Nieve',
    'Tomorrow 8-9 Temp' => 'Mañana 8-9 Temp.',
    'Tomorrow 8-9 Weather' => 'Mañana 8-9 Clima',
    'Tomorrow 8-9 Wind Direction' => 'Mañana 8-9 Dirección del Viento',
    'Tomorrow 8-9 Wind Speed' => 'Mañana 8-9 Velocidad del Viento',
    // home_announcements / banner_ads (note the misspelled variant too).
    'Announcements and News:' => 'Anuncios y Noticias:',
    'Annoucements and News:' => 'Anuncios y Noticias:',
    // media_gallery (homepage "Recent Observations:" block title).
    'Recent Observations:' => 'Observaciones Recientes:',
    // observations view.
    'Snowpack, Weather, and Avalanche Observations' => 'Observaciones de Nieve, Clima y Avalanchas',
    'Location' => 'Ubicación',
    'Observation made by' => 'Observación realizada por',
    'Date and time of observation' => 'Fecha y hora de la observación',
    'Date and time of observation or avalanche occurrence' => 'Fecha y hora de la observación o del evento de avalancha',
    'Snowpack, Avalanche, Weather Images' => 'Imágenes de Nieve, Avalancha y Clima',
    'Snowpack, Avalanche, Weather Videos' => 'Videos de Nieve, Avalancha y Clima',
    'Snowpit or crown profile photo or graph' => 'Foto o gráfico de perfil de nieve o corona',
    // incidents.
    'Avalanche Incidents' => 'Incidentes de Avalancha',
    // events_upcoming.
    'Upcoming Events:' => 'Próximos Eventos:',
    'Events' => 'Eventos',
    'Event Calendar' => 'Calendario de Eventos',
    'Event Calendar Day' => 'Calendario de Eventos - Día',
    'Event Calendar Week' => 'Calendario de Eventos - Semana',
    'Event Calendar Month' => 'Calendario de Eventos - Mes',
    'Event Calendar Year' => 'Calendario de Eventos - Año',
    // week_in_review_views (note the misspelled "Arichives" as shipped).
    'Week in Review' => 'Resumen Semanal',
    'Week in Review Arichives' => 'Archivo de Resúmenes Semanales',
    // advisory_board.
    'Advisory Board' => 'Junta Asesora',
    'Board of Directors' => 'Junta Directiva',
    'Forecasters' => 'Pronosticadores',
    'Professional Observers' => 'Observadores Profesionales',
    'Staff' => 'Personal',
    // considerable_sponsors (per-tier blocks + list).
    'Sponsors' => 'Patrocinadores',
    'Sponsors List' => 'Lista de Patrocinadores',
    'Summit Sponsors' => 'Patrocinadores Cumbre',
    'Extreme Sponsors' => 'Patrocinadores Extremo',
    'High Sponsors' => 'Patrocinadores Alto',
    'Considerable Sponsors' => 'Patrocinadores Considerable',
    'Moderate Sponsors' => 'Patrocinadores Moderado',
    'Low Sponsors' => 'Patrocinadores Bajo',
  );

  // Date-format patterns (PHP date() syntax). The English ordinal ("jS" ->
  // "29th") and "at"/"@" separators read wrong in Spanish; use the
  // "j de F de Y a las G:i" convention. Month/day names themselves are
  // translated by locale at format time. The ISO machine format is left as-is.
  $dates = array(
    'l, F jS, Y' => 'l, j \d\e F \d\e Y',
    'F j, Y \a\t G:i' => 'j \d\e F \d\e Y \a \l\a\s G:i',
    'F j, Y \a\t G:i a' => 'j \d\e F \d\e Y \a \l\a\s G:i a',
    'F j, Y \@ g:ia' => 'j \d\e F \d\e Y \a \l\a\s g:ia',
  );

  // Every shipped view is scanned, but only exact-match strings are touched,
  // so the map itself scopes the change.
  $config_dir = backdrop_get_path('profile', 'avalanche_center') . '/config';
  foreach (glob($config_dir . '/views.view.*.json') as $file) {
    $name = basename($file, '.json');
    $config = config($name);
    if ($config->isNew()) {
      continue;
    }
    $data = $config->get();
    $changed = FALSE;
    avalanche_center_localize_walk($data, array('title' => TRUE, 'label' => TRUE), $strings, $changed);
    avalanche_center_localize_walk($data, array('custom_date_format' => TRUE), $dates, $changed);
    if ($changed) {
      $config->setData($data);
      $config->save();
    }
  }

  // Content-type display label (admin: /node/add, content lists). The machine
  // name stays "advisory"; only the human label changes.
  $type = config('node.type.advisory');
  if (!$type->isNew()) {
    $type->set('name', 'Pronóstico');
    $type->save();
  }
}

/**
 * Localizes the visitor-facing menu titles.
 *
 * Menu titles are stored config (not t()), and the footer menu blocks render
 * the menu title as their heading (they set no title of their own). Exact-
 * match guarded: only the shipped English default is replaced, so a center's
 * own renamed menu title is preserved on a migration.
 *
 * @param string $langcode
 *   Target language; a no-op if no map is shipped for it.
 */
function avalanche_center_localize_menus($langcode) {
  if ($langcode !== 'es') {
    return;
  }
  $titles = array(
    'main-menu' => array('Main menu' => 'Menú Principal'),
    'menu-about' => array('About' => 'Acerca de'),
    'menu-archives' => array('People' => 'Usuarios'),
    'menu-contact' => array('Resources' => 'Recursos'),
    'menu-doormat-menu' => array('Footer Menu' => 'Enlaces'),
    'menu-responsive-links' => array('Responsive Links' => 'Enlaces Adaptables'),
  );
  foreach ($titles as $menu_name => $map) {
    $config = config('menu.menu.' . $menu_name);
    if ($config->isNew()) {
      continue;
    }
    $current = $config->get('title');
    if (isset($map[$current])) {
      $config->set('title', $map[$current]);
      $config->save();
    }
  }
}

/**
 * Localizes the observation submission form: content-type name/title/help,
 * every field instance's label + description, and the option lists (allowed
 * values) on its select fields. All of these are stored config, never t(), so
 * the PO import can't reach them. Center-agnostic generic SWAG-style
 * observation vocabulary; option lists are also converted to metric where they
 * carried imperial units. A no-op for languages with no map.
