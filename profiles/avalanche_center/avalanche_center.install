    'field_position' => array('Public' => 'Público', 'Forecaster' => 'Pronosticador', 'Professional Observer' => 'Observador Profesional', 'Guide' => 'Guía', 'Educator' => 'Educador', 'Program Manager' => 'Director de Programa', 'Board of Directors' => 'Junta Directiva', 'Advisory Board' => 'Junta Asesora'),
    'field_persistent_weak_layers' => array('On the surface' => 'En la superficie', 'Buried' => 'Enterrada', 'Not observed' => 'No observada', 'Not present' => 'No presente'),
    'field_terrain_alerts' => array('Slopes Steeper than 30 degrees' => 'Pendientes de más de 30 grados', 'Obvious Slide Path' => 'Vía de avalancha evidente', 'Trigger Points' => 'Puntos de detonación', 'Terrain Traps' => 'Trampas de terreno', 'Terrain Matches the Forecast' => 'El terreno coincide con el pronóstico'),
    'field_terrain_elevations' => array('Above Treeline' => 'Sobre el límite arbóreo', 'Near Treeline' => 'Cerca del límite arbóreo', 'Below Treeline' => 'Bajo el límite arbóreo'),
    'field_today_s_assessed_hazard_ab' => array('Insufficient Data' => 'Datos insuficientes', 'VG' => 'Muy Buena', 'G' => 'Buena', 'F' => 'Regular', 'P' => 'Mala', 'VP' => 'Muy Mala'),
    'field_trigger_modifier' => array('intentionally-triggered' => 'Detonada intencionalmente', 'accidentally-triggered' => 'Detonada accidentalmente', 'remotely-triggered' => 'Detonada a distancia', 'cornice-fall-triggered' => 'Detonada por caída de cornisa'),
    'field_crown_height' => array('-1' => 'Menos de 0,3 m', '1' => '0,3 m', '2' => '0,6 m', '3' => '0,9 m', '4' => '1,2 m', '5' => '1,5 m', '6' => '1,8 m', '7' => '2,1 m', '8' => '2,4 m', '9' => '2,7 m', '10' => '3 m', '11' => 'Más de 3 m'),
