  $dict_options['field_today_s_assessed_hazard_ne'] = $dict_options['field_today_s_assessed_hazard_ab'];

  foreach ($dict_options as $field => $map) {
    $config = config('field.field.' . $field);
    if ($config->isNew()) {
      continue;
    }
    $allowed = $config->get('settings.allowed_values');
    if (!is_array($allowed)) {
      continue;
    }
    foreach ($map as $key => $label) {
      if (array_key_exists($key, $allowed)) {
        $allowed[$key] = $label;
      }
    }
    $config->set('settings.allowed_values', $allowed);
    $config->save();
  }

  // List-style allowed_values (numerically indexed): translate matching values
  // in place, preserving order.
  $list_options = array(
    'field_is_this_an_avalanche_obser' => array('Yes' => 'Sí', 'No' => 'No'),
    'field_number_of_full_burials' => array('More than 5' => 'Más de 5'),
    'field_number_of_partial_burials' => array('More than 5' => 'Más de 5'),
    'field_number_of_people_caught_2' => array('More than 5' => 'Más de 5'),
  );
  foreach ($list_options as $field => $map) {
    $config = config('field.field.' . $field);
    if ($config->isNew()) {
      continue;
    }
    $allowed = $config->get('settings.allowed_values');
    if (!is_array($allowed)) {
      continue;
    }
    foreach ($allowed as $i => $val) {
      if (isset($map[$val])) {
        $allowed[$i] = $map[$val];
      }
    }
    $config->set('settings.allowed_values', $allowed);
    $config->save();
  }
}

/**
 * Rewrites the observations/incidents views' header-area explanatory text.
 *
 * These views show a multi-sentence intro paragraph above the list/map (a
 * Views "area" handler, stored as HTML in config - never through t(), so the
 * PO import can't reach it, same as the menu blocks). Each shipped view has
 * the paragraph on several displays (list page, map page, archives); this sets
 * the target-language copy on every one. Idempotent (overwrites). The English
 * shipped copy is already the generic version, so this only runs for other
 * languages. Center-agnostic - generic backcountry-observation boilerplate.
 *
 * @param string $langcode
 *   Target language; a no-op if no copy is shipped for it.
 */
function avalanche_center_localize_view_headers($langcode) {
  if ($langcode !== 'es') {
    return;
  }

  $obs_disclaimer = '<p>Estas observaciones describen las condiciones en un único punto en el tiempo y el espacio, y pueden no representar las condiciones donde usted planea desplazarse. Provienen de diversas fuentes —algunas profesionales, otras del público— y no se puede garantizar su calidad ni exactitud. Utilícelas como una parte de su recopilación de información y nunca base sus decisiones en un solo dato. Envíe sus propias observaciones mediante los botones a continuación.</p>';
  $obs_map = '<p>Este mapa muestra las observaciones de manto de nieve y de avalanchas enviadas. Las observaciones de manto de nieve se muestran con marcadores azules y las de avalanchas con marcadores rojos. Haga clic en un marcador para ver la observación.</p>';
  $inc_desc = '<p>Esta página muestra los incidentes de avalancha reportados en el backcountry que involucraron a una persona atrapada, enterrada y/o herida.</p>';

  // config name => (display machine name => header HTML).
  $headers = array(
    'views.view.observations' => array(
      'default' => $obs_disclaimer,
      'page_1' => $obs_disclaimer,
      'page_5' => $obs_disclaimer,
      'page_2' => $obs_map,
      'page_4' => $obs_map,
    ),
    'views.view.incidents' => array(
      'default' => $inc_desc,
      'page_2' => $inc_desc,
      'page_3' => $inc_desc,
    ),
  );

  foreach ($headers as $config_name => $displays) {
    $config = config($config_name);
    if ($config->isNew()) {
      continue;
    }
    $data = $config->get();
    $changed = FALSE;
    foreach ($displays as $display => $html) {
      if (!isset($data['display'][$display]['display_options']['header']['area'])) {
        continue;
      }
      $area = &$data['display'][$display]['display_options']['header']['area'];
      // Header content is either a scalar string or a {value, format} array,
      // depending on the area handler - preserve whichever shape it has.
      if (isset($area['content']) && is_array($area['content'])) {
        $area['content']['value'] = $html;
      }
      else {
        $area['content'] = $html;
      }
      unset($area);
      $changed = TRUE;
    }
    if ($changed) {
      $config->setData($data);
      $config->save();
    }
  }
}

/**
 * Recursively replaces string values under whitelisted keys using an
 * exact-match map. Helper for avalanche_center_localize_views().
 *
 * @param array $data
 *   Config data, modified by reference.
 * @param array $keys
 *   Keys whose string values are eligible for replacement (as a set:
 *   key => TRUE).
 * @param array $map
 *   Exact English => translated string map.
 * @param bool $changed
 *   Set to TRUE (by reference) if any replacement was made.
 */
function avalanche_center_localize_walk(&$data, $keys, $map, &$changed) {
  if (!is_array($data)) {
    return;
  }
  foreach ($data as $key => &$value) {
    if (is_array($value)) {
      avalanche_center_localize_walk($value, $keys, $map, $changed);
    }
    elseif (isset($keys[$key]) && is_string($value) && isset($map[$value])) {
      $value = $map[$value];
      $changed = TRUE;
    }
  }
}

/**
 * Force-applies specific shipped config files, overwriting whatever's
 * already active.
 *
 * config_install_default_config() (which normally imports everything in
 * profiles/avalanche_center/config/) only ever creates new config, never
 * overwrites existing config - by design, so it's safe to re-run. But it
 * means any config name a *module we depend on* also ships its own default
 * for silently keeps that module's default instead of ours, if that
 * module gets enabled first (nearly always true for core modules, since
 * profiles install last). Found via Phase 7's greenfield install test:
 * `user` module ships its own empty-permission `user.role.anonymous` /
 * `user.role.authenticated`, so our exported versions (with real
 * permissions - "access content" etc.) were silently discarded, leaving
 * anonymous visitors and logged-in users alike unable to view the site at
 * all. Re-applied here, explicitly, after normal config import has run.
 *
 * @param array $config_names
 *   Config object names (matching a .json filename, minus the extension)
 *   to load from this profile's config/ directory and force-save over
 *   whatever's currently active.
 */
function avalanche_center_force_apply_config($config_names) {
  $config_dir = backdrop_get_path('profile', 'avalanche_center') . '/config';
  foreach ($config_names as $name) {
    $file = $config_dir . '/' . $name . '.json';
    if (!file_exists($file)) {
      continue;
    }
    $data = json_decode(file_get_contents($file), TRUE);
    if (!is_array($data)) {
      continue;
    }
    unset($data['_config_name']);
    config($name)->setData($data)->save();
  }
}

/**
 * Creates a full demo dataset - two forecast-zone regions with an advisory
 * each, plus at least one node in every other content type, real menu
 * links, and the taxonomy terms a couple of shipped Views filter on - so a
 * fresh install actually looks like a real, populated center site (matching
 * the Gulmarg/Argentina baseline structurally) instead of one empty page.
 *
 * Found via a Phase 7 parity pass against both reference sites' live
 * databases: the homepage's block placement (layout.layout.node.json) was
 * already correctly exported back in Phase 5 - every block Gulmarg's
 * front page actually uses (danger map, sponsors, media gallery, events,
 * announcements, etc.) is really there. It just had nothing to show,
 * because (a) menu links and custom-block content are database content in
 * Backdrop, not config, so Phase 4/5's config-only export correctly never
 * captured them, and (b) none of the content types those blocks' Views
 * query had a single node in a fresh install. This function is what fills
 * that gap. See plan §21.
 *
 * @param float $lat
 *   Map center latitude, from the setup form.
 * @param float $lng
 *   Map center longitude, from the setup form.
 */
function avalanche_center_create_demo_content($lat, $lng) {
  module_load_include('inc', 'geofield', 'libraries/geophp/geoPHP');

  $page_category = avalanche_center_demo_terms('page_category', array('skiday'));
  $class_type = avalanche_center_demo_terms('class_type', array('general', 'snowmobile'));
  $sponsor_level = avalanche_center_demo_terms('sponsor_level', array(
    'Summit', 'Extreme', 'High', 'Considerable', 'Moderate', 'Low',
  ));

  // Two forecast zones, offset from the map center so they don't overlap,
  // each with its own advisory - a single-region demo undersells centers
  // that forecast for more than one zone, which is the norm, not the
  // exception, on both reference sites.
  $region_a = avalanche_center_demo_region(t('North Zone'), $lat, $lng, 0.12, -0.03);
  $region_b = avalanche_center_demo_region(t('South Zone'), $lat, $lng, -0.12, 0.03);
  avalanche_center_demo_advisory($region_a, 1, t('This is a demo avalanche forecast created automatically at install so the danger map has something to show. Watch for wind slab and cornice hazards on steep, wind-loaded slopes. Replace it with a real forecast, or delete it.'));
  avalanche_center_demo_advisory($region_b, 2, t('A second demo avalanche forecast for the second demo forecast zone. Evaluate the snowpack carefully for persistent slab instabilities before entering avalanche terrain. Replace it with a real forecast, or delete it.'));

  // Dedicated home page. Matching the Gulmarg/Argentina baseline, the front
  // page is its own standalone "page" node aliased to "home", NOT a promoted
  // forecast - the danger map (a layout block conditioned on the "home"
  // path) is the home page's main content, and the page node itself carries
  // no body so nothing competes with the map. The layout hides the node
  // title on the front page, so this renders as just the map.
  $home_page = avalanche_center_demo_node('page', array(
    'title' => t('Home'),
  ));

  // One demo "page" node per generic destination the demo menus below
  // link to - real centers will have their own About/Contact/etc. pages,
  // these just mean the menus aren't pointing at nothing out of the box.
  $about_page = avalanche_center_demo_node('page', array(
    'title' => t('About Us'),
    'body' => array('value' => t('Tell visitors who your center is and what you do. Replace this placeholder page with your own About page.'), 'format' => 'filtered_html'),
  ));
  $donate_page = avalanche_center_demo_node('page', array(
    'title' => t('Donate'),
    'body' => array('value' => avalanche_center_demo_donate_body(), 'format' => 'full_html'),
  ));
  $contact_page = avalanche_center_demo_node('page', array(
    'title' => t('Contact Us'),
    'body' => array('value' => t('Add your center\'s contact details here. Replace this placeholder with your own page.'), 'format' => 'filtered_html'),
  ));
  $faq_page = avalanche_center_demo_node('page', array(
    'title' => t('Frequently Asked Questions'),
    'body' => array('value' => t('Answer the questions your visitors ask most. Replace this placeholder with your own page.'), 'format' => 'filtered_html'),
  ));

  // Three ready-to-use avalanche-education reference pages (generic,
  // industry-standard content: how to read a forecast, the danger scale, and
  // the nine avalanche problem types). Given fixed aliases so the Advisory
  // dropdown's "Forecast Resources" links resolve. A center can edit or
  // delete them like any other page.
  avalanche_center_demo_reference_page(t('How to Read the Avalanche Forecast'), 'how-to-read-avalanche-forecast', 'how-to-read-avalanche-forecast.html');

  // The danger-scale page follows the chosen preset: SAC gets the South
  // American scale (title + body), NAC the North American one. The alias is
  // deliberately preset-independent so the Advisory-dropdown and how-to-read
  // links resolve either way.
  if (config_get('avalanche_center.settings', 'danger_scale') === 'SAC') {
    avalanche_center_demo_reference_page(t('South American Avalanche Danger Scale'), 'avalanche-danger-scale', 'south-american-avalanche-danger-scale.html');
  }
  else {
    avalanche_center_demo_reference_page(t('North American Avalanche Danger Scale'), 'avalanche-danger-scale', 'north-american-avalanche-danger-scale.html');
  }

  avalanche_center_demo_reference_page(t('Avalanche Problems'), 'avalanche-problems', 'avalanche-problems.html');

  // Populate the Avalanche Terms glossary (names, definitions, and synonyms).
  // The "Mark glossary terms" filter (avalanche_glossary) then auto-links
  // these terms wherever they appear in full_html content, e.g. advisories.
  avalanche_center_import_avalanche_terms();

  // Populate the hierarchical Conditions Alerts vocabulary (the observation
  // form's "Conditions Alerts" field references it).
  avalanche_center_import_conditions_alerts();

  // The sponsor-tier home-page blocks also filter on expiration date being
  // in the future, so give the demo sponsor one.
  avalanche_center_demo_node('sponsor', array(
    'title' => t('Example Sponsor'),
    'field_sponsor_name' => array('value' => t('Example Sponsor')),
    'field_sponsor_link' => array('url' => 'https://example.com', 'title' => t('Example Sponsor')),
    'field_expiration_date' => array('value' => date('Y-m-d H:i:s', strtotime('+1 year'))),
    'taxonomy_vocabulary_4' => array('tid' => $sponsor_level['Summit']),
  ));

  avalanche_center_demo_node('announcements', array(
    'title' => t('Welcome to Our New Website'),
    'body' => array('value' => t('This is a demo announcement. Replace it with your own site news.'), 'format' => 'filtered_html'),
  ));

  // The events_upcoming view filters on the event's *end* date (value2)
  // being in the future, so demo events need both a start and an end date
  // (field_event_date's todate is "optional"), or they never show as
  // "upcoming".
  avalanche_center_demo_node('events', array(
    'title' => t('Community Ski Day'),
    'body' => array('value' => t('A demo community ski day event.'), 'format' => 'filtered_html'),
    'field_event_date' => array('value' => date('Y-m-d H:i:s', strtotime('+2 weeks')), 'value2' => date('Y-m-d H:i:s', strtotime('+2 weeks +4 hours'))),
    'field_page_category' => array('tid' => $page_category['skiday']),
  ));
  avalanche_center_demo_node('events', array(
    'title' => t('Avalanche Awareness Night'),
    'body' => array('value' => t('A demo public awareness event.'), 'format' => 'filtered_html'),
    'field_event_date' => array('value' => date('Y-m-d H:i:s', strtotime('+3 weeks')), 'value2' => date('Y-m-d H:i:s', strtotime('+3 weeks +2 hours'))),
  ));

  avalanche_center_demo_node('class', array(
    'title' => t('Introduction to Avalanche Safety'),
    'body' => array('value' => t('A demo introductory avalanche safety class.'), 'format' => 'filtered_html'),
    'field_event_date' => array('value' => date('Y-m-d H:i:s', strtotime('+1 month')), 'value2' => date('Y-m-d H:i:s', strtotime('+1 month +3 hours'))),
    'field_class_type' => array('tid' => $class_type['general']),
  ));
  avalanche_center_demo_node('class', array(
    'title' => t('Snowmobiler Avalanche Awareness'),
    'body' => array('value' => t('A demo avalanche safety class for snowmobilers.'), 'format' => 'filtered_html'),
    'field_event_date' => array('value' => date('Y-m-d H:i:s', strtotime('+5 weeks')), 'value2' => date('Y-m-d H:i:s', strtotime('+5 weeks +3 hours'))),
    'field_class_type' => array('tid' => $class_type['snowmobile']),
  ));

  avalanche_center_demo_node('week_in_review', array(
    'title' => t('Week in Review'),
    'body' => array('value' => t('A demo weekly summary of conditions and observations.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('observation', array(
    'title' => t('Demo Observation'),
    'field_is_this_an_avalanche_obser' => array('value' => 0),
    'field_ob_date_time' => array('value' => date('Y-m-d H:i:s')),
    'field_ob_loc_name' => array('value' => t('Near the demo forecast zone')),
    'field_published_ob' => array('value' => 'yes'),
    'field_share_this_observation_' => array('value' => 'yes'),
  ));

  avalanche_center_demo_node('avalanche_education', array(
    'title' => t('Avalanche Education Program'),
    'body' => array('value' => t('A demo overview of your education program.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('avalanche_watch', array(
    'title' => t('Avalanche Watch'),
    'body' => array('value' => t('A demo avalanche watch, issued ahead of a forecast when conditions may warrant one.'), 'format' => 'filtered_html'),
    'field_duration' => array('value' => 48),
    'field_expected_danger_rating' => array('value' => 'Considerable'),
    'field_overalldanger' => array('value' => 3),
  ));

  avalanche_center_demo_node('banner_ad', array(
    'title' => t('Example Sponsor Banner'),
    'body' => array('value' => t('A demo sponsor banner ad.'), 'format' => 'filtered_html'),
    'field_expiration_date' => array('value' => date('Y-m-d H:i:s', strtotime('+1 year'))),
  ));

  avalanche_center_demo_node('card', array(
    'title' => t('Featured Card'),
    'body' => array('value' => t('A demo featured content card.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('custom_map', array(
    'title' => t('Custom Map Example'),
    'field_map_region' => array('geom' => sprintf('POINT(%F %F)', $lng, $lat)),
    'field_region_color' => array('value' => '#FF0000'),
  ));

  avalanche_center_demo_node('feed_item', array(
    'title' => t('Feed Item Example'),
    'field_feed_item_description' => array('value' => t('A demo feed item description.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('feed', array(
    'title' => t('Feed Example'),
  ));

  avalanche_center_demo_node('fwp', array(
    'title' => t('Field Work Plan Example'),
    'field_terrain_choice' => array('value' => t('Demo terrain choice notes.'), 'format' => 'filtered_html'),
    'field_field_work_date' => array('value' => date('Y-m-d H:i:s')),
  ));

  avalanche_center_demo_node('map', array(
    'title' => t('Site Map'),
    'body' => array('value' => t('A demo site map page.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('media_gallery', array(
    'title' => t('Photo Gallery Example'),
  ));

  avalanche_center_demo_node('post', array(
    'title' => t('Sample Blog Post'),
    'body' => array('value' => t('A demo blog-style post.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('simplenews', array(
    'title' => t('Sample Newsletter Issue'),
    'body' => array('value' => t('A demo newsletter issue.'), 'format' => 'filtered_html'),
  ));

  avalanche_center_demo_node('snowpack_summary', array(
    'title' => t('Snowpack Summary Example'),
    'field_bottom_line' => array('value' => t('A demo snowpack summary bottom line.'), 'format' => 'filtered_html'),
    'field_disclaimer' => array('value' => t('Demo disclaimer text.'), 'format' => 'filtered_html'),
    'field_duration' => array('value' => 24),
    'field_forecast_region' => array('tid' => $region_a),
  ));

  // People, tagged with the field_display_order values the shipped
  // advisory_board view's "board"/"forecasters"/"non-profit-staff" page
  // displays each filter on (see plan §21) - without these, those 3 menu-
  // archives destinations would be empty pages.
  avalanche_center_demo_node('people', array(
    'title' => t('Jane Doe'),
    'field_sac_people_name' => array('value' => t('Jane Doe')),
    'field_display_order' => array('value' => 1),
  ));
  avalanche_center_demo_node('people', array(
    'title' => t('John Smith'),
    'field_sac_people_name' => array('value' => t('John Smith')),
    'field_display_order' => array('value' => 9),
  ));
  avalanche_center_demo_node('people', array(
    'title' => t('Alex Lee'),
    'field_sac_people_name' => array('value' => t('Alex Lee')),
    'field_display_order' => array('value' => 6),
  ));

  // ski_days/snowmobile_classes (profiles/avalanche_center/config/) filter
  // on a hardcoded taxonomy term ID copied straight from Gulmarg's own
  // database - meaningless on a fresh install, where term IDs are assigned
  // at creation time above. Patch both views to point at the real ones.
  avalanche_center_patch_view_term_filter('ski_days', 'default', 'field_page_category_tid', array($page_category['skiday']));
  avalanche_center_patch_view_term_filter('snowmobile_classes', 'default', 'field_class_type_tid', array($class_type['snowmobile']));

  // The considerable_sponsors view has one block display per sponsor tier,
  // each with a hardcoded sponsor_level term ID from Gulmarg's database
  // (block_1 = Extreme = tid 2, ... block_8 = Summit = tid 17). Repoint each
  // at the tier term this install just created so the tier blocks on the
  // home page actually match the demo sponsor. Same hardcoded-tid problem as
  // ski_days above.
  $sponsor_tier_blocks = array(
    'block_1' => array($sponsor_level['Extreme']),
    'block_2' => array($sponsor_level['High']),
    'block_3' => array($sponsor_level['Considerable']),
    'block_4' => array($sponsor_level['Moderate']),
    'block_5' => array($sponsor_level['Low']),
    'block_6' => array($sponsor_level['Summit']),
    'block_7' => array($sponsor_level['Summit']),
    'block_8' => array($sponsor_level['Summit']),
  );
  foreach ($sponsor_tier_blocks as $display => $tids) {
    avalanche_center_patch_view_term_filter('considerable_sponsors', $display, 'tid', $tids);
  }

  avalanche_center_demo_menu_links($about_page->nid, $donate_page->nid, $contact_page->nid, $faq_page->nid);

  // Point the front page at the dedicated home page node (a bodyless "page"
  // node, created above), not at a forecast - matching the Gulmarg/Argentina
  // baseline, where site_frontpage is a standalone "page" node aliased to
  // "home" (Gulmarg: node/5950), not a promoted advisory. Core's default
  // front page ("node", the promoted-content list) doesn't match the node/%
  // layout the danger map block lives in, so without this the map renders
  // nowhere. A real center repoints this at its own landing content later.
  config_set('system.core', 'site_frontpage', 'node/' . $home_page->nid);

  // Alias the home page node to "home". Many home-page blocks (danger map,
  // media gallery, announcements, sponsor tiers, etc.) carry a path-
  // visibility condition of "home" rather than "<front>", and on both
  // reference sites it's this alias on the front-page node that makes those
  // conditions match. Without it only the few blocks conditioned on
  // "<front>" render, leaving the home page half-empty.
  $alias = array('source' => 'node/' . $home_page->nid, 'alias' => 'home');
  path_save($alias);
}

/**
 * Creates a forecast-zone region term with a small placeholder polygon.
 *
 * @param string $name
 *   Term name.
 * @param float $lat
 *   Map center latitude.
 * @param float $lng
 *   Map center longitude.
 * @param float $lat_offset
 *   Degrees to offset the polygon's center from $lat, so multiple demo
 *   zones don't overlap.
 * @param float $lng_offset
 *   Degrees to offset the polygon's center from $lng.
 *
 * @return int
 *   The new term's tid.
 */
function avalanche_center_demo_region($name, $lat, $lng, $lat_offset, $lng_offset) {
  $center_lat = $lat + $lat_offset;
  $center_lng = $lng + $lng_offset;
  $delta = 0.05;
  $wkt = sprintf(
    'POLYGON((%F %F, %F %F, %F %F, %F %F, %F %F))',
    $center_lng - $delta, $center_lat - $delta,
    $center_lng + $delta, $center_lat - $delta,
    $center_lng + $delta, $center_lat + $delta,
    $center_lng - $delta, $center_lat + $delta,
    $center_lng - $delta, $center_lat - $delta
  );

  // taxonomy_term_save() type-hints against the Entity API's TaxonomyTerm
  // class, not stdClass - entity_create() returns the right class
  // (TaxonomyTerm's bundle key is 'vocabulary', per taxonomy_entity_info()'s
  // 'bundle keys').
  $term = entity_create('taxonomy_term', array('vocabulary' => 'region'));
  $term->name = $name;
  $term->description = t('Placeholder forecast zone created at install. Replace with your real forecast zones, or delete this one.');
  $term->format = filter_default_format();
  $term->field_region_map[LANGUAGE_NONE][0]['geom'] = $wkt;
  taxonomy_term_save($term);
  return $term->tid;
}

/**
 * Creates a demo advisory for a forecast-zone region.
 *
 * @param int $region_tid
 *   The region term's tid to reference.
 * @param int $danger_level
 *   Overall danger level (1-5) for this demo advisory.
 * @param string $bottom_line
 *   Bottom-line text.
 *
 * @return Node
 *   The saved advisory node.
 */
function avalanche_center_demo_advisory($region_tid, $danger_level, $bottom_line) {
  $node = entity_create('node', array('type' => 'advisory'));
  node_object_prepare($node);
  $node->title = t('Demo Avalanche Forecast');
  $node->language = LANGUAGE_NONE;
  $node->status = 1;
  $node->promote = 0;
  $node->uid = 1;

  $node->field_forecast_region[LANGUAGE_NONE][0]['tid'] = $region_tid;
  $node->field_overalldanger[LANGUAGE_NONE][0]['value'] = $danger_level;
  $node->field_danger_rating_1[LANGUAGE_NONE][0]['value'] = 'Low';
  $node->field_danger_rating_2[LANGUAGE_NONE][0]['value'] = 'Low';
  $node->field_danger_rating_3[LANGUAGE_NONE][0]['value'] = 'Low';
  $node->field_duration[LANGUAGE_NONE][0]['value'] = 24;
  $node->field_bottom_line[LANGUAGE_NONE][0]['value'] = $bottom_line;
  // full_html to match how advisories are authored on the live sites (the
  // "full html + mark glossary terms" WYSIWYG profile), so the glossary
  // auto-link filter marks terms in the bottom line.
  $node->field_bottom_line[LANGUAGE_NONE][0]['format'] = 'full_html';

  // field_rose_{1,2,3} (danger_rose_picker, from the danger_rose module) are
  // not Field-API "required" on advisory, but danger_rose_field_schema()
  // declares all 24 of its per-aspect columns NOT NULL with no fallback -
  // saving a node that never sets any value for these fields hits a DB
  // constraint violation, not a Field API validation error. Zero-fill them.
  $empty_rose = array_fill(0, 24, 0);
  foreach (array('field_rose_1', 'field_rose_2', 'field_rose_3') as $rose_field) {
    $node->{$rose_field}[LANGUAGE_NONE][0] = $empty_rose;
  }

  node_save($node);
  return $node;
}

/**
 * Creates one demo node of a given content type.
 *
 * @param string $type
 *   Node type machine name.
 * @param array $values
 *   Field values keyed by field name (or 'title'). Each non-title value is
 *   assigned as-is to $node->{field}[LANGUAGE_NONE][0], so pass the exact
 *   shape that field type expects (e.g. array('value' => ...) for a text
 *   field, array('tid' => ...) for a term reference, array('geom' => ...)
 *   for a geofield).
 *
 * @return Node
 *   The saved node.
 */
function avalanche_center_demo_node($type, array $values) {
  $node = entity_create('node', array('type' => $type));
  node_object_prepare($node);
  $node->language = LANGUAGE_NONE;
  $node->status = 1;
  $node->promote = 0;
  $node->uid = 1;
  $node->title = $values['title'];
  unset($values['title']);

  foreach ($values as $field => $value) {
    $node->{$field}[LANGUAGE_NONE][0] = $value;
  }

  node_save($node);
  return $node;
}

/**
 * Creates a reference "page" node from a shipped HTML content file, at a
 * fixed URL alias.
 *
 * Used for the generic avalanche-education pages (how to read a forecast,
 * the danger scale, avalanche problems) whose bodies live in this profile's
 * content/ directory. A fixed alias is forced (replacing pathauto's
 * auto-generated one) so the Advisory-dropdown links to these pages resolve
 * on every install regardless of node ID.
 *
 * @param string $title
 *   Page title.
 * @param string $alias
 *   The URL alias to force (e.g. 'avalanche-problems').
 * @param string $filename
 *   Filename within profiles/avalanche_center/content/.
 *
 * @return Node
 *   The saved node.
 */
function avalanche_center_demo_reference_page($title, $alias, $filename) {
  $dir = backdrop_get_path('profile', 'avalanche_center') . '/content/';

  // Reference-page bodies are raw HTML loaded verbatim (not run through t()),
  // so on a non-English install prefer a language-matched translation of the
  // body - e.g. avalanche-problems.es.html for a Spanish install - falling
  // back to the English file when no translation is shipped.
  $file = $dir . $filename;
  $langcode = config_get('system.core', 'language_default');
  if (!empty($langcode) && $langcode !== 'en') {
    $localized = $dir . preg_replace('/\.html$/', '.' . $langcode . '.html', $filename);
    if (file_exists($localized)) {
      $file = $localized;
    }
  }

  $body = file_exists($file) ? file_get_contents($file) : '';

  $node = avalanche_center_demo_node('page', array(
    'title' => $title,
    'body' => array('value' => $body, 'format' => 'full_html'),
  ));

  // Force our own alias: node_save() above already let pathauto assign one
  // (basic-page/<title>), so clear any existing alias for this node before
  // saving the fixed one the menu links depend on.
  path_delete(array('source' => 'node/' . $node->nid));
  $path = array('source' => 'node/' . $node->nid, 'alias' => $alias);
  path_save($path);

  return $node;
}

/**
 * Builds the placeholder Donate-page body.
 *
 * Deliberately example content, not a finished page: a center drops its own
 * donation button/embed into the "Donate Online" box and replaces the
 * bracketed [tokens] with its real address, tax ID, etc. The prose and the
 * "Other Ways to Give" categories are genericized from the Gulmarg
 * (/donate-old) and Argentina (/donate) reference pages - no center-specific
 * names, addresses, tax IDs, or memorial funds carried over. Rendered with
 * the full_html format so a pasted payment-provider embed works.
 *
 * @return string
 *   HTML for the node body.
 */
function avalanche_center_demo_donate_body() {
  $intro = t('This is a placeholder Donate page. Replace the example text below with your own donation information, and drop your real donation button or embed into the "Donate Online" box.');
  $support_h = t('Support the Avalanche Center');
  $support_p = t('Our avalanche center is a nonprofit organization. We rely on donations, memberships, and fundraising to keep producing daily avalanche forecasts, observations, and education for our community. Please consider making a tax-deductible gift - every contribution helps keep this service free for everyone who travels in avalanche terrain.');
  $online_h = t('Donate Online');
  $online_box = t('Add your donation button or embed here.');
  $online_hint = t('Paste the embed code from your payment provider (PayPal, Stripe, Donorbox, Fundly, GoFundMe, etc.) in place of this box - for example a PayPal "Donate" button, or a simple link like the one below.');
  $online_link = t('Donate with PayPal');
  $other_h = t('Other Ways to Give');
  $mail_h = t('By Mail');
  $mail_p = t('Prefer to mail a check? Send donations to:');
  $corp_h = t('Corporate Giving &amp; Sponsorship');
  $corp_p = t('We rely on the generous support of individuals, corporate partners, resorts, and foundations who share our vision. Corporate contributions and sponsorships directly support our forecasting and education programs. See our current sponsors or contact us to discuss partnership opportunities.');
  $endow_h = t('Endowment Fund');
  $endow_p = t('An endowment fund helps ensure the long-term sustainability of avalanche forecasting and awareness in our region. Contact us to learn how you can contribute.');
  $memorial_h = t('Memorial &amp; Tribute Gifts');
  $memorial_p = t('Honor a friend, family member, or fellow backcountry traveler with a memorial or tribute gift supporting avalanche awareness and education.');
  $planned_h = t('Planned Giving');
  $planned_p = t('Have you thought of including the avalanche center in your estate planning? By naming a nonprofit as a beneficiary of your will or life insurance, you can leave behind a lasting legacy of avalanche safety. Talk to your estate-planning professional for details.');
  $tax_h = t('Tax Information');
  $tax_p = t('We are a 501(c)(3) nonprofit organization and donations are tax-deductible to the extent allowed by law. Our tax ID (EIN) is <strong>[your EIN here]</strong>. Recognition on our website is available for individual and corporate donors - email us for details.');
  $thanks = t('Thank you for your support - we cannot operate without you!');

  return <<<HTML
<p><em>$intro</em></p>

<h2>$support_h</h2>
<p>$support_p</p>

<h2>$online_h</h2>
<div style="border:2px dashed #999; padding:1.5em; text-align:center; background:#f7f7f7;">
  <p><strong>$online_box</strong></p>
  <p>$online_hint</p>
  <p><a href="https://www.paypal.com/donate" target="_blank" rel="noopener">$online_link</a></p>
</div>

<h2>$other_h</h2>

<h3>$mail_h</h3>
<p>$mail_p<br />
[Your Avalanche Center]<br />
[Street Address]<br />
[City, State ZIP]</p>

<h3>$corp_h</h3>
<p>$corp_p</p>

<h3>$endow_h</h3>
<p>$endow_p</p>

<h3>$memorial_h</h3>
<p>$memorial_p</p>

<h3>$planned_h</h3>
<p>$planned_p</p>

<h2>$tax_h</h2>
<p>$tax_p</p>

<p><em>$thanks</em></p>
HTML;
}

/**
 * Creates a set of taxonomy terms in a vocabulary, keyed by name.
 *
 * @param string $vocabulary
 *   Vocabulary machine name.
 * @param array $names
 *   Term names to create.
 *
 * @return array
 *   Map of name => new tid.
 */
function avalanche_center_demo_terms($vocabulary, array $names) {
  $tids = array();
  foreach ($names as $name) {
    $term = entity_create('taxonomy_term', array('vocabulary' => $vocabulary));
    $term->name = $name;
    taxonomy_term_save($term);
    $tids[$name] = $term->tid;
  }
  return $tids;
}

/**
 * Imports the Avalanche Terms glossary from the shipped JSON data file.
 *
 * Creates one taxonomy term per entry in content/avalanche-terms.json, in the
 * "avalanche_terms" vocabulary, with its definition (HTML, full_html format)
 * and any synonyms (field_synonyms). These feed both the glossary page and
 * the "Mark glossary terms" content filter.
 */
function avalanche_center_import_avalanche_terms() {
  $file = backdrop_get_path('profile', 'avalanche_center') . '/content/avalanche-terms.json';
  if (!file_exists($file)) {
    return;
  }
  $entries = json_decode(file_get_contents($file), TRUE);
  if (!is_array($entries)) {
    return;
  }

  foreach ($entries as $entry) {
    if (empty($entry['name'])) {
      continue;
    }
    $term = entity_create('taxonomy_term', array('vocabulary' => 'avalanche_terms'));
    $term->name = $entry['name'];
    // Strip any trailing whitespace or leftover \r\n escape sequences so the
    // rendered definition doesn't end with a stray blank line.
    $description = isset($entry['description']) ? $entry['description'] : '';
    $term->description = preg_replace('/(\\\\r|\\\\n|\s)+$/', '', $description);
    $term->format = 'full_html';
    if (!empty($entry['synonyms']) && is_array($entry['synonyms'])) {
      $delta = 0;
      foreach ($entry['synonyms'] as $synonym) {
        $synonym = trim($synonym);
        if ($synonym === '') {
          continue;
        }
        $term->field_synonyms[LANGUAGE_NONE][$delta]['value'] = $synonym;
        $delta++;
      }
    }
    taxonomy_term_save($term);
  }
}

/**
 * Imports the hierarchical Conditions Alerts vocabulary from the shipped
 * content/conditions-alerts.json file.
 *
 * Each top-level entry becomes a term in the "conditions_alerts" vocabulary;
 * its "children" become child terms (parent set to the top-level term), so
 * the observation form's multi-select "Conditions Alerts" field shows the
 * same grouped hierarchy as the reference site. Order is preserved as term
 * weight. Duplicate child names under different parents (e.g. "Rain on Snow"
 * appears under two groups) are created as distinct terms, matching the
 * source.
 */
function avalanche_center_import_conditions_alerts() {
  $file = backdrop_get_path('profile', 'avalanche_center') . '/content/conditions-alerts.json';
  if (!file_exists($file)) {
    return;
  }
  $entries = json_decode(file_get_contents($file), TRUE);
  if (!is_array($entries)) {
    return;
  }

  $weight = 0;
  foreach ($entries as $entry) {
    if (empty($entry['name'])) {
      continue;
    }
    $parent = entity_create('taxonomy_term', array('vocabulary' => 'conditions_alerts'));
    $parent->name = $entry['name'];
    // parent must be an array - taxonomy's postSave() iterates over it.
    $parent->parent = array(0);
    $parent->weight = $weight++;
    taxonomy_term_save($parent);

    if (!empty($entry['children']) && is_array($entry['children'])) {
      $child_weight = 0;
      foreach ($entry['children'] as $child_name) {
        $child_name = trim($child_name);
        if ($child_name === '') {
          continue;
        }
        $child = entity_create('taxonomy_term', array('vocabulary' => 'conditions_alerts'));
        $child->name = $child_name;
        $child->parent = array($parent->tid);
        $child->weight = $child_weight++;
        taxonomy_term_save($child);
      }
    }
  }
}

/**
 * Patches a shipped view's taxonomy-term filter to a real tid.
 *
 * ski_days/snowmobile_classes (profiles/avalanche_center/config/) were
 * copied from Gulmarg's own exported config with their term-ID filter
 * values intact - meaningless on any other install, since taxonomy term
 * IDs are assigned per-database at creation time, not portable structural
 * data. Same force-apply pattern as avalanche_center_force_apply_config(),
 * but editing one nested filter value instead of replacing the whole file.
 *
 * @param string $view_name
 *   View machine name (e.g. 'ski_days').
 * @param string $display
 *   The display whose filter to patch (e.g. 'default', 'block_1').
 * @param string $filter_id
 *   The filter's key in that display's display_options.filters (e.g.
 *   'field_page_category_tid').
 * @param array $tids
 *   The real term IDs to filter on.
 */
function avalanche_center_patch_view_term_filter($view_name, $display, $filter_id, array $tids) {
  $config = config('views.view.' . $view_name);
  $path = "display.$display.display_options.filters.$filter_id.value";
  $config->set($path, array_map('strval', $tids));
  $config->save();
}

/**
 * Creates the main/footer/secondary menu links a fresh install otherwise
 * has none of - menu links are database content in Backdrop, not config,
 * so profiles/avalanche_center/config/'s menu.menu.*.json files only ship
 * the empty menu containers. Structure (which menus, how many levels)
 * mirrors Gulmarg/Argentina's actual live main-menu/footer/about/archives/
 * contact menus; labels and destinations are generic, pointing at this
 * distribution's own real paths and the demo pages created above - not
 * copied verbatim from either site's site-specific link text/URLs.
 *
 * @param int $about_nid
 *   The demo "About Us" page node ID.
 * @param int $donate_nid
 *   The demo "Donate" page node ID.
 * @param int $contact_nid
 *   The demo "Contact Us" page node ID.
 * @param int $faq_nid
 *   The demo "Frequently Asked Questions" page node ID.
 */
function avalanche_center_demo_menu_links($about_nid, $donate_nid, $contact_nid, $faq_nid) {
  // Main menu - mirrors Gulmarg's live main-menu structure (top-level items
  // and their nesting), pointed at this distribution's own generic paths.
  // Gulmarg's own submenu groups are Observations (-> Submit Observations
  // -> Submit Professional Observations, three levels deep), Education, and
  // Event Calendar. The calendar's Month/Week/Day/Year children need the
  // contrib "calendar" module (which neither reference site actually
  // ships), so Events points at the working events list instead of dead
  // calendar-style sub-pages. Site-specific Gulmarg items with no generic
  // equivalent (the two "rescue grid map" children, the external Fundly
  // donate link) are dropped.
  avalanche_center_demo_menu_link('main-menu', t('Home'), '<front>', -10);

  $advisory_mlid = avalanche_center_demo_menu_link('main-menu', t('Forecast'), 'forecast', -9);

  $obs_mlid = avalanche_center_demo_menu_link('main-menu', t('Observations'), 'observations', -8);
  $submit_mlid = avalanche_center_demo_menu_link('main-menu', t('Submit Observations'), 'node/add/observation', 0, $obs_mlid);
  avalanche_center_demo_menu_link('main-menu', t('Submit Professional Observations'), 'node/add/observation', 0, $submit_mlid);

  $incidents_mlid = avalanche_center_demo_menu_link('main-menu', t('Incidents'), 'incidents', -7);

  $edu_mlid = avalanche_center_demo_menu_link('main-menu', t('Education'), 'education', -6);
  avalanche_center_demo_menu_link('main-menu', t('Avalanche Terms'), 'avalanche-terms', 0, $edu_mlid);
  avalanche_center_demo_menu_link('main-menu', t('Know Before You Go'), 'https://kbyg.org/', 1, $edu_mlid);

  avalanche_center_demo_menu_link('main-menu', t('Events'), 'events', -5);
  avalanche_center_demo_menu_link('main-menu', t('Sponsors'), 'sponsors-list', -4);
  avalanche_center_demo_menu_link('main-menu', t('About Us'), 'node/' . $about_nid, -3);
  $donate_mlid = avalanche_center_demo_menu_link('main-menu', t('Donate'), 'node/' . $donate_nid, -2);

  // Build the TB Mega Menu dropdowns, matching Gulmarg's live tb_megamenus
  // layout: Advisory/Observations/Incidents each open a 2-column dropdown of
  // custom link blocks; Education opens a normal child-item dropdown (left
  // to tb_megamenu's own sync). The Donate item gets the "donate-menu" CSS
  // class so the theme paints it in the accent color, as on both reference
  // sites. See avalanche_center_build_megamenu().
  avalanche_center_build_megamenu(array(
    'advisory' => $advisory_mlid,
    'observations' => $obs_mlid,
    'incidents' => $incidents_mlid,
    'donate' => $donate_mlid,
  ));

  avalanche_center_demo_menu_link('menu-doormat-menu', t('Observations'), 'observations', -50);
  avalanche_center_demo_menu_link('menu-doormat-menu', t('Avalanche Terms'), 'avalanche-terms', -49);
  avalanche_center_demo_menu_link('menu-doormat-menu', t('Events'), 'events', -48);
  avalanche_center_demo_menu_link('menu-doormat-menu', t('RSS Feed'), 'rss.xml', -47);
  avalanche_center_demo_menu_link('menu-doormat-menu', t('Email Subscriptions'), 'newsletter/subscriptions', -46);

  avalanche_center_demo_menu_link('menu-about', t('News and Announcements'), 'news', -10);
  avalanche_center_demo_menu_link('menu-about', t('About Us'), 'node/' . $about_nid, -9);
  avalanche_center_demo_menu_link('menu-about', t('Contact Us'), 'node/' . $contact_nid, -8);

  avalanche_center_demo_menu_link('menu-archives', t('Forecasters'), 'forecasters', -10);
  avalanche_center_demo_menu_link('menu-archives', t('Board of Directors'), 'board', -9);
  avalanche_center_demo_menu_link('menu-archives', t('Non Profit Staff'), 'non-profit-staff', -8);

  avalanche_center_demo_menu_link('menu-contact', t('Frequently Asked Questions'), 'node/' . $faq_nid, -50);

  avalanche_center_demo_menu_link('menu-responsive-links', t('Forecast'), 'forecast', 1);
  avalanche_center_demo_menu_link('menu-responsive-links', t('Observations'), 'observations', 2);
  avalanche_center_demo_menu_link('menu-responsive-links', t('Donate'), 'node/' . $donate_nid, 3);
}

/**
 * Saves one menu link.
 *
 * @param string $menu_name
 *   Menu machine name.
 * @param string $title
 *   Link title.
 * @param string $path
 *   Internal path (or an external URL, or '<front>').
 * @param int $weight
 *   Sort weight.
 * @param int $plid
 *   Parent mlid, or 0 for a top-level link.
 *
 * @return int
 *   The new link's mlid.
 */
function avalanche_center_demo_menu_link($menu_name, $title, $path, $weight = 0, $plid = 0) {
  $link = array(
    'menu_name' => $menu_name,
    'link_title' => $title,
    'link_path' => $path,
    'weight' => $weight,
    'plid' => $plid,
    // customized = 1 marks the link as human-created ("don't touch"). Without
    // it, menu_rebuild()'s _menu_navigation_links_rebuild() cleanup pass
    // deletes any link with customized = 0 whose router path isn't a
    // currently-registered *visible* menu router item - which silently wiped
    // most of these demo links on the first attempt, since view-page and
    // module paths aren't always registered as visible at the moment the
    // post-install cache flush rebuilds the menu. This is the same flag the
    // menu admin UI sets on every link a person adds by hand.
    'customized' => 1,
  );
  menu_link_save($link);
  return isset($link['mlid']) ? $link['mlid'] : 0;
}

/**
 * Writes the TB Mega Menu configuration for the main menu.
 *
 * tb_megamenu stores its per-menu layout in the tb_megamenus DB table (not
 * config), keyed by menu_name+language, as two JSON blobs: block_config
 * (animation/behaviour) and menu_config (per-top-level-item column layout,
 * keyed by mlid). Reproduces Gulmarg's live mega-menu: Advisory,
 * Observations, and Incidents each open a 2-column dropdown of custom link
 * blocks (block.custom.2/4/5/6/7, shipped in this profile's config), with
 * the same column widths, submenu width, animation, and item styling.
 * Education and the rest are left out of menu_config so tb_megamenu's own
 * sync renders them as ordinary child-item dropdowns.
 *
 * The mlid keys can't be shipped as static config (mlids are assigned per
 * database when the links are created), so this runs at install time with
 * the real mlids captured in avalanche_center_demo_menu_links().
 *
 * @param array $mlids
 *   Map with 'advisory', 'observations', 'incidents' => top-level mlid.
 */
function avalanche_center_build_megamenu($mlids) {
  // Behaviour block - copied verbatim from Gulmarg's tb_megamenus row.
  $block_config = array(
    'animation' => 'none',
    'duration' => 400,
    'delay' => 200,
    'style' => '',
    'auto-arrow' => '1',
    'always-show-submenu' => '0',
  );

  // Shared styling for every configured top-level item, matching Gulmarg.
  $item_config = array(
    'class' => '', 'xicon' => '', 'caption' => '', 'alignsub' => 'left',
    'group' => '0', 'hidewcol' => '0', 'hidesub' => '0',
  );
  $submenu_config = array('width' => '500', 'class' => '', 'group' => '0');

  // Helper: one column holding a single block, by full "module--delta" key.
  $block_col = function ($block_key, $width) {
    return array(
      'col_content' => array(array(
        'block_key' => $block_key,
        'type' => 'block',
        'tb_item_config' => array(),
      )),
      'col_config' => array(
        'width' => (string) $width, 'class' => '', 'hidewcol' => '', 'showblocktitle' => '1',
      ),
    );
  };

  // Advisory: 2 cols (6/6) - the zone-aware Forecast Links block (a module
  //   block, not a static custom block, so its links change with the number
  //   of forecast zones - see avalanche_danger_map_advisory_links()) |
  //   Forecast Resources (block.custom.4).
  // Observations: 2 cols (7/5) - Observations | Submit Observations.
  // Incidents: 2 cols (6/6) - Incidents | Submit Observations.
  $menu_config = array(
    (string) $mlids['advisory'] => array(
      'rows_content' => array(array(
        $block_col('avalanche_danger_map--advisory_links', 6),
        $block_col('block--4', 6),
      )),
      'submenu_config' => $submenu_config,
      'item_config' => $item_config,
    ),
    (string) $mlids['observations'] => array(
      'rows_content' => array(array($block_col('block--5', 7), $block_col('block--7', 5))),
      'submenu_config' => $submenu_config,
      'item_config' => $item_config,
    ),
    (string) $mlids['incidents'] => array(
      'rows_content' => array(array($block_col('block--6', 6), $block_col('block--7', 6))),
      'submenu_config' => $submenu_config,
      'item_config' => $item_config,
    ),
    // Donate: no dropdown, just tag the <li> with "donate-menu" so the theme
    // paints it in the accent color (tb_megamenu copies item_config.class
    // onto the rendered <li>). Both reference sites highlight Donate this way.
    (string) $mlids['donate'] => array(
      'rows_content' => array(),
      'submenu_config' => array('width' => '', 'class' => '', 'group' => '0'),
      'item_config' => array('class' => 'donate-menu') + $item_config,
    ),
  );

  // tb_megamenu stores (and looks up) its config per language: at render time
  // it reads the row for the current interface language and, if missing,
  // auto-syncs a blank default - which drops the dropdowns and the Donate
  // highlight. Key the row to the site's default language so a Spanish install
  // (es) finds it, not just an English one. (Interface negotiation is pinned
  // to language-default, so the render language equals this.)
  $langcode = config_get('system.core', 'language_default');
  if (empty($langcode)) {
    $langcode = 'en';
  }
  db_merge('tb_megamenus')
    ->key(array('menu_name' => 'main-menu', 'language' => $langcode))
    ->fields(array(
      'block_config' => json_encode($block_config),
      'menu_config' => json_encode($menu_config),
    ))
    ->execute();
}
