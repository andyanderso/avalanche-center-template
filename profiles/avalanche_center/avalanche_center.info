name = Avalanche Center
description = Installable distribution for avalanche forecast center websites (danger maps, observations, advisories, glossary).
type = profile
backdrop = 1.x

; --- Core module dependencies ---
; Cross-checked against system.extensions.json (both sites) during Phase 5 -
; that file mirrors the DB-stored enabled/disabled state, unlike the rest of
; config. Confirmed: Commerce, registration, gmap_polygon_field, emfield,
; hs_taxonomy, media, select_or_other, and term_reference_tree are all
; disabled on both sites (their config is dead cruft, excluded - see plan
; §16/§18); "email" is enabled on both sites but its module code isn't
; present in either reference codebase - needs sourcing from
; backdropcms.org before first install (field_email on the observation type
; depends on it structurally, not just optionally).
dependencies[] = node
dependencies[] = field
dependencies[] = field_ui
dependencies[] = image
dependencies[] = taxonomy
dependencies[] = path
; language + locale are enabled for every install so that source strings are
; registered from the start; the "Center setup" task only imports the bundled
; Spanish .po and switches the default language when Spanish is chosen.
dependencies[] = language
dependencies[] = locale
dependencies[] = views
dependencies[] = views_ui
dependencies[] = block
dependencies[] = menu
dependencies[] = comment
dependencies[] = date
dependencies[] = link
dependencies[] = list
dependencies[] = number
dependencies[] = options
dependencies[] = file
dependencies[] = config
; Missed by the Phase 5 system.extensions.json cross-check above (it's
; enabled on both sites but has no content-model footprint of its own) -
; caught by Phase 7's greenfield install: avalanche_modern's template.php
; calls backdrop_get_form('search_form') unconditionally in the header.
dependencies[] = search
; Found by directly diffing Gulmarg's live enabled-module list (system table)
; against this file during a demo-site parity pass - all core, already
; vendored since we ship full Backdrop core, just never declared:
dependencies[] = admin_bar
