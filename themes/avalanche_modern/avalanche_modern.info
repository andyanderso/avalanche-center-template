type = theme
name = Avalanche Center Modern
description = Modern forecast-first theme for an avalanche center. Switchable with responsive_sac.
backdrop = 1.x
base theme = responsive_bartik
version = 1.x-1.x

stylesheets[all][] = css/base.css
stylesheets[all][] = css/layout.css
stylesheets[all][] = css/components.css
stylesheets[all][] = css/advisory.css
stylesheets[all][] = css/observations.css
stylesheets[all][] = css/home.css

scripts[] = js/avalanche_modern.js
scripts[] = js/megamenu_keepinview.js

regions[banner] = Banner
regions[header] = Header
regions[header_middle] = Header middle
regions[help] = Help
regions[page_top] = Page top
regions[page_bottom] = Page bottom
regions[highlighted] = Highlighted
regions[megamenu] = Megamenu

regions[featured] = Featured
regions[content] = Content
regions[side_decor] = Side decor
regions[sidebar_first] = Sidebar first
regions[sidebar_second] = Sidebar second

regions[triptych_first] = Triptych first
regions[triptych_middle] = Triptych middle
regions[triptych_last] = Triptych last

regions[footer_firstcolumn] = Footer first column
regions[footer_secondcolumn] = Footer second column
regions[footer_thirdcolumn] = Footer third column
regions[footer_fourthcolumn] = Footer fourth column
regions[footer_fifthcolumn] = Footer fifth column
regions[footer] = Footer

; Reuse the same theme settings as responsive_sac so shared templates/preprocess work.
; All defaults below are neutral English/NAC placeholders — every center overrides
; them via theme settings or the install-profile "Center setup" form.
settings[email_url] = /email-subscriptions
settings[facebook_url] =
settings[twitter_url] =
settings[youtube_url] =
settings[instagram_url] =
settings[upper_elevation_band] = Above Treeline
settings[middle_elevation_band] = Near Treeline
settings[lower_elevation_band] = Below Treeline
settings[enable_danger_rose_view] = 0
settings[local_nws_name] =
settings[local_nws_url] =
settings[wx_elevation_low] =
settings[wx_elevation_high] =
settings[current_wx_conditions_desc] = Weather observations from local stations.
settings[show_forecast_region] = 1
settings[wx_map_page] = /weather-station-map
settings[wx_table_page] = /weather-stations
settings[obs_page] = /observations
settings[submit_snowpack_obs_page] = /node/add/observation
settings[submit_avalanche_obs_page] = /node/add/observation
settings[forecaster_name_field] = field_first_name
settings[map_first] = 0

; Header site name / slogan visibility (standard Backdrop toggle settings).
settings[toggle_name] = 1
settings[toggle_slogan] = 0
settings[advisory_weather_expanded] = 0
; No default logo is shipped (a generic distribution can't ship any one
; center's brand) — leave the logo hidden until a center uploads its own
; via theme settings.
settings[toggle_logo] = 0
